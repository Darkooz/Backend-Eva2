# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
# Solo si se publica detrás de HTTPS (ej: https://midominio.cl)
CSRF_TRUSTED_ORIGINS=

# --- Base de datos MySQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Correo (recuperación de contraseña) ---
# Desarrollo: console imprime el correo en la terminal.
# Producción: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# Gmail: usar una "contraseña de aplicación", no la contraseña personal
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Vigencia del enlace de recuperación en segundos (3600 = 1 hora)
PASSWORD_RESET_TIMEOUT=3600
# True si el sitio se sirve por https
PASSWORD_RESET_USE_HTTPS=False
